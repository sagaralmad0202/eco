// ---------------------------------------------------------------
// E-commerce database schema
//
// Design rules applied throughout:
//   1. All money is Decimal(10,2). NEVER Float — floats lose paise.
//   2. Orders store a SNAPSHOT of price/name/address at purchase time,
//      so changing a product later never rewrites history.
//   3. Stock and price live on the VARIANT, not the product.
//   4. Financial records are never cascade-deleted.
// ---------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled — used by the app
  directUrl = env("DIRECT_URL") // unpooled — used by migrations
}

// ------------------------- ENUMS -------------------------

enum Role {
  CUSTOMER
  ADMIN
}

enum AddressType {
  SHIPPING
  BILLING
}

enum OrderStatus {
  PENDING // created, payment not yet confirmed
  CONFIRMED // payment captured
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum ContactMessageStatus {
  NEW
  READ
  RESOLVED
}

// ------------------------- USERS & AUTH -------------------------

model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique
  passwordHash String
  fullName     String

  // Profile fields, all edited from /account. Nullable because signup only
  // asks for email, password and name — never block registration on these.
  //
  // phone is declared here to match the users.phone column the init migration
  // created. Nothing reads it yet, but leaving it out made schema.prisma and
  // the database disagree, which is enough for `prisma migrate dev` to see
  // drift and offer to drop the column.
  phone       String?   @unique
  dateOfBirth DateTime? @db.Date // Date, not DateTime: a birthday has no timezone
  gender      String? // "Male" | "Female" | "Other", validated in zod
  aboutYou    String?
  avatarUrl   String?

  // Free-text locality shown on the account page ("Los Angeles, CA"), kept
  // deliberately separate from the Address model. Address rows are structured
  // (line1, postalCode, phone) because checkout and the immutable order
  // snapshot depend on those parts individually; this is a profile label a
  // customer types for themselves and nothing ships to it.
  address String?

  role            Role      @default(CUSTOMER)
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  addresses               Address[]
  orders                  Order[]
  cart                    Cart?
  wishlist                Wishlist[]
  reviews                 Review[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  oauthAccounts           OAuthAccount[]
  oauthExchangeCodes      OAuthExchangeCode[]
  contactMessages         ContactMessage[]

  @@map("users")
}

// Refresh tokens are stored HASHED, exactly like passwords.
// If the database leaks, the raw tokens are not usable.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// Password reset links, stored HASHED for the same reason as refresh tokens:
// a leaked database must not hand an attacker a working reset link for every
// account. Only the raw token goes in the email; only its hash is stored.
//
// usedAt exists separately from deletion so a reset link is strictly
// single-use. Without it, anyone who later reads the email (a shared inbox,
// a forwarded thread, a synced backup) could reset the password again.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Email verification, hashed for the same reason as the two token tables
// above. Separate from PasswordResetToken rather than reusing it with a "kind"
// column: the two have different lifetimes and different blast radius if
// leaked, and a single table invites using a verification link to reset a
// password by mistake.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// Social login identities. Normalised one-row-per-(provider, provider id) so
// a single user can sign in with Google today and Facebook next year, and a
// provider id can never be attached to two accounts.
//
// No provider access/refresh tokens are stored: the app never calls provider
// APIs after login, so persisting them would only create a secret worth
// stealing with no feature to justify it.
model OAuthAccount {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  provider       String // "google" | "facebook" | "twitter"
  providerUserId String
  providerEmail  String? // snapshot at link time, informational only
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

// Short-lived CSRF state for the OAuth redirect round-trip. Only the SHA-256
// hash of the state value is stored, mirroring the other token tables: a
// leaked database must not contain a usable state for a pending redirect.
model OAuthState {
  id           String   @id @default(uuid()) @db.Uuid
  stateHash    String   @unique
  provider     String
  codeVerifier String? // PKCE verifier for providers that support it
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("oauth_states")
}

// One-time codes handed to the frontend after a successful OAuth login. The
// provider callback redirects the browser to the SPA with this code in the
// URL; the SPA immediately swaps it for the real access token over a POST.
// Raw access/refresh tokens therefore never appear in a URL, history entry
// or referer header. Stored hashed and single-use, like every other token.
model OAuthExchangeCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("oauth_exchange_codes")
}

model Address {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  type       AddressType @default(SHIPPING)
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String      @default("IN")
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ------------------------- CATALOG -------------------------

// Self-referencing tree: "Men" -> "Footwear" -> "Running Shoes"
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  parentId  String?  @db.Uuid
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  brand       String?
  image       String?
  categoryId  String?  @db.Uuid
  // Products are deactivated, never deleted — old orders reference them.
  isActive    Boolean  @default(true)
  // Drives the home page's curated rails. A flag rather than "newest N" so
  // merchandising is a deliberate choice, not an accident of upload order.
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants  ProductVariant[]
  images    ProductImage[]
  reviews   Review[]
  wishlists Wishlist[]

  @@index([categoryId])
  @@index([isActive])
  // Composite, not a bare isFeatured index: the home page always asks for
  // featured AND active together, so one index answers the whole filter.
  @@index([isFeatured, isActive])
  @@map("products")
}

// A product is "Nike Air Zoom". A variant is "Blue / UK 9".
// Price and stock belong HERE, because sizes sell independently.
model ProductVariant {
  id             String   @id @default(uuid()) @db.Uuid
  productId      String   @db.Uuid
  sku            String   @unique
  title          String // "Blue / UK 9"
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2) // for "₹2999 ~~₹3999~~"
  stock          Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  url       String
  alt       String?
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ------------------------- CART -------------------------

// One cart per user. sessionId supports guests who have not logged in yet.
model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @unique @db.Uuid
  sessionId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

// Note: no price stored here on purpose. A cart should always show the
// CURRENT price. Price is frozen only when the order is placed.
model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @db.Uuid
  variantId String   @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Adding the same variant twice increments quantity instead of duplicating.
  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

// ------------------------- WISHLIST -------------------------

// One row per saved product. Login is required — a wishlist follows the
// account, unlike a cart which also supports guests.
//
// Both sides cascade. Products are deactivated rather than deleted (see
// Product.isActive), so a real delete only happens when a product is being
// purged outright — at which point a saved row pointing at nothing is dead
// weight. Deactivation, the normal case, leaves the row alone and the API
// returns it flagged as unavailable.
model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // A product is either saved or it is not — toggling twice must not
  // produce two rows.
  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlists")
}

// ------------------------- ORDERS -------------------------

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  orderNumber String      @unique // human-readable, e.g. "ORD-2026-000148"
  userId      String?     @db.Uuid
  status      OrderStatus @default(PENDING)

  subtotal    Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  shippingFee Decimal @default(0) @db.Decimal(10, 2)
  tax         Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  currency    String  @default("INR")

  // Address is COPIED, not linked. If the customer edits or deletes their
  // saved address later, the invoice must still show where it was shipped.
  shippingName       String
  shippingPhone      String
  shippingLine1      String
  shippingLine2      String?
  shippingCity       String
  shippingState      String
  shippingPostalCode String
  shippingCountry    String  @default("IN")

  couponCode String?
  placedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // SetNull, not Cascade: deleting a user must never delete financial records.
  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([placedAt])
  @@map("orders")
}

// Every field here is a snapshot taken at checkout.
// Renaming a product or changing its price must not alter past orders.
model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  variantId String? @db.Uuid

  productName  String
  imageUrl     String?
  variantTitle String
  sku          String
  unitPrice    Decimal @db.Decimal(10, 2)
  quantity     Int
  lineTotal    Decimal @db.Decimal(10, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// ------------------------- PAYMENTS -------------------------

// One order can have several payment attempts (fail, retry, succeed).
// providerPaymentId is unique — this is what makes webhook retries safe.
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @db.Uuid
  provider          String        @default("razorpay")
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  signature         String?
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  rawPayload        Json? // full gateway response, for dispute resolution
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

// ------------------------- REVIEWS & COUPONS -------------------------

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  rating    Int // 1..5, enforced by a CHECK constraint in the migration
  title     String?
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // One review per customer per product.
  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

model Coupon {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique
  discountType  DiscountType
  value         Decimal      @db.Decimal(10, 2)
  minOrderTotal Decimal?     @db.Decimal(10, 2)
  maxDiscount   Decimal?     @db.Decimal(10, 2) // caps percentage coupons
  usageLimit    Int?
  usedCount     Int          @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("coupons")
}

// ------------------------- CONTACT -------------------------

// Contact form submissions. Supports both guests (userId = null) and authenticated users.
// Optional foreign key to User ensures support inquiries can link to customer accounts.
model ContactMessage {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String?              @db.Uuid
  fullName  String
  email     String
  message   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

