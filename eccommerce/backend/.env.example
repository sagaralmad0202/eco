# ---------------------------------------------------------------
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file — it is in .gitignore for a reason.
# ---------------------------------------------------------------

# Neon gives you TWO connection strings. You need both.
#
# DATABASE_URL  -> the POOLED string (host contains "-pooler")
#                  Used by your app at runtime. Handles many connections.
#
# DIRECT_URL    -> the DIRECT / unpooled string (no "-pooler" in host)
#                  Used only by "prisma migrate". Migrations fail on a
#                  pooled connection, which is a very common first bug.

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Server
PORT=5000
NODE_ENV=development

# Auth — generate a long random string, do not use this placeholder
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend origin allowed by CORS
CLIENT_ORIGIN="http://localhost:3000"
