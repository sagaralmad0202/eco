# ---------------------------------------------------------------
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file — it is in .gitignore for a reason.
# ---------------------------------------------------------------

# Neon gives you TWO connection strings. You need both.
#
# DATABASE_URL  -> the POOLED string (host contains "-pooler")
#                  Used by your app at runtime. Handles many connections.
#
# DIRECT_URL    -> the DIRECT / unpooled string (no "-pooler" in host)
#                  Used only by "prisma migrate". Migrations fail on a
#                  pooled connection, which is a very common first bug.

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Server
PORT=5000
NODE_ENV=development

# Auth — generate a long random string, do not use this placeholder
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend origin allowed by CORS
CLIENT_ORIGIN="http://localhost:3000"

# Public backend origin used to turn stored /media paths into browser URLs.
PUBLIC_API_ORIGIN="http://localhost:5000"

# ---- Email (password reset) ------------------------------------
# Optional. If SMTP_HOST is blank, reset links are logged to the
# server console instead of emailed — fine for local development.
#
# Gmail: create an App Password (requires 2-Step Verification) at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
# Host smtp.gmail.com, port 587.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Ciseco Support <no-reply@ciseco.local>"

# How long a password reset link stays valid.
PASSWORD_RESET_EXPIRES_IN="30m"

# ---- Cart totals -----------------------------------------------
# Flat rates. Both are optional and have defaults, so the API boots
# without them.
#
# Shipping charged per order, not per item.
SHIPPING_FLAT_FEE="5.00"

# Subtotal at which shipping becomes free. Leave blank to always
# charge SHIPPING_FLAT_FEE.
FREE_SHIPPING_ABOVE=""

# Percentage applied to the subtotal. 18 = GST.
TAX_PERCENT="18"

# ---- Razorpay TEST MODE only ----------------------------------
# Generate these with the Razorpay Dashboard switched to Test Mode.
# The key id must begin with rzp_test_. Never commit real values.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ---- Social login (Google / Facebook / Twitter-X) ---------------
# All OPTIONAL: leave every group blank and the API runs exactly as
# before, with the OAuth endpoints answering 503 instead of redirecting.
#
# Redirect URIs have sane defaults derived from PUBLIC_API_ORIGIN:
#   http://localhost:5000/api/auth/oauth/google/callback   (etc.)
# Only set the *_REDIRECT_URI vars if the backend is reachable on a
# different public URL than PUBLIC_API_ORIGIN.
#
# Never commit real values. See OAUTH_SETUP.md for where each
# client id / secret comes from.

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_REDIRECT_URI=""

TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
TWITTER_REDIRECT_URI=""
